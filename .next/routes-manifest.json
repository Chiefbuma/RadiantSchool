{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/portal/applications/[id]/status",
      "regex": "^/api/portal/applications/([^/]+?)/status(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/portal/applications/(?<nxtPid>[^/]+?)/status(?:/)?$"
    },
    {
      "page": "/api/portal/entities/[entity]",
      "regex": "^/api/portal/entities/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPentity": "nxtPentity"
      },
      "namedRegex": "^/api/portal/entities/(?<nxtPentity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/portal/entities/[entity]/[id]",
      "regex": "^/api/portal/entities/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPentity": "nxtPentity",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/portal/entities/(?<nxtPentity>[^/]+?)/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/portal/requests/[id]",
      "regex": "^/api/portal/requests/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/portal/requests/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/portal/students/[id]",
      "regex": "^/api/portal/students/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/portal/students/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/whatsapp/offers/[token]",
      "regex": "^/api/whatsapp/offers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/api/whatsapp/offers/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/portal/admin/students/[id]",
      "regex": "^/portal/admin/students/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/portal/admin/students/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/portal/admin/[module]",
      "regex": "^/portal/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmodule": "nxtPmodule"
      },
      "namedRegex": "^/portal/admin/(?<nxtPmodule>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/portal",
      "regex": "^/portal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal(?:/)?$"
    },
    {
      "page": "/portal/admin",
      "regex": "^/portal/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal/admin(?:/)?$"
    },
    {
      "page": "/portal/student",
      "regex": "^/portal/student(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal/student(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}